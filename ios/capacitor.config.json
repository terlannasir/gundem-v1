{
  "appId": "az.gundem.app",
  "appName": "Gündəm",
  "webDir": "www",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0A2427",
    "limitsNavigationsToAppBoundDomains": false,
    "allowsLinkPreview": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 600,
      "launchAutoHide": true,
      "backgroundColor": "#0A2427",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": true,
      "style": "DEFAULT"
    }
  }
}