{
  "appId": "az.gundem.app",
  "appName": "Gündəm",
  "webDir": "www",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0A2427",
    "limitsNavigationsToAppBoundDomains": false,
    "allowsLinkPreview": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 3000,
      "launchAutoHide": true,
      "backgroundColor": "#0A2427",
      "showSpinner": true,
      "iosSpinnerStyle": "large",
      "spinnerColor": "#3DBFB4"
    },
    "StatusBar": {
      "overlaysWebView": true,
      "style": "DEFAULT"
    }
  },
  "server": {
    "url": "https://gundem-sesi.onrender.com",
    "allowNavigation": [
      "gundem-sesi.onrender.com"
    ],
    "errorPath": "error.html"
  }
}
