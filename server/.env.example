# Lokal işə salmaq üçün: cp .env.example .env  →  npm run dev
# Render-də bu dəyərlər Dashboard → Environment bölməsində yazılır (render.yaml əksəriyyətini özü qurur).

# --- Server ---
PORT=8080
PUBLIC_URL=http://localhost:8080          # Render-də lazım deyil (RENDER_EXTERNAL_URL avtomatik götürülür)
APP_SCHEME=gundem                          # iOS deep link: gundem://auth?code=...

# --- Gizli açarlar (yarat: openssl rand -base64 32) ---
JWT_SECRET=
TOKEN_ENC_KEY=

# --- Baza: Supabase → Connect → Session pooler (URI) ---
DATABASE_URL=postgresql://postgres.xxxx:PAROL@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# DATABASE_CA="-----BEGIN CERTIFICATE-----..."   # Supabase → Database → SSL → Download certificate (tam yoxlama üçün, tövsiyə)
# LOG_REQUESTS=1                             # hər sorğunu logla (default: yalnız xətalar)

# --- Google Cloud → Google Auth Platform → Clients → Web application ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DRIVE_SCOPE=full                           # full = bütün Drive (test rejimi üçün) · file = yalnız tətbiqin yaratdığı fayllar

# --- Süni intellekt: gemini (pulsuz plan var) və ya anthropic (Claude, ödənişli) ---
AI_PROVIDER=gemini
GEMINI_API_KEY=                            # aistudio.google.com/apikey
# MODEL_SMART=gemini-3.5-flash
# MODEL_FAST=gemini-3.5-flash-lite
# Pulsuz limit bir modeldə dolanda növbəti pulsuz modelə keçir (vergüllə):
# MODEL_FALLBACK_SMART=gemini-3.6-flash,gemini-3.7-flash,gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# MODEL_FALLBACK_FAST=gemini-3.1-flash-lite,gemini-3.6-flash,gemini-3.5-flash
# ANTHROPIC_API_KEY=                       # AI_PROVIDER=anthropic olduqda

# --- Planlar (aylıq AI sorğu limiti) ---
FREE_AI_REQUESTS=600
PREMIUM_AI_REQUESTS=6000

# --- RevenueCat webhook (sonra, Premium üçün) ---
REVENUECAT_WEBHOOK_SECRET=
