    "exceljs": "^4.4.0",
    "fastify": "^5.12.5",
    "googleapis": "^181.0.0",
    "jose": "^6.2.12",
    "mammoth": "^1.12.3",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.23.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
