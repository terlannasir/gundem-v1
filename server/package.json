{
  "name": "gundem-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gündəm server — Google sign-in, Gmail/Calendar/Drive tools, AI (Gemini or Claude), web app",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
